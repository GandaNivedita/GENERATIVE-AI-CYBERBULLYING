# Copy this file to ".env" and fill in your own values.
# The real .env is git-ignored (see .gitignore) — never commit secrets.

# Groq API keys (comma-separated). The LLM client (src/llm_client.py) rotates
# through these to spread load and survive per-key free-tier rate limits.
# Example: GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
GROQ_API_KEYS=

# Model used for every LLM call. Defaults to llama-3.1-8b-instant if unset.
GROQ_MODEL=llama-3.1-8b-instant

# Evaluation sample size PER CLASS (6 classes -> 6 * EVAL_PER_CLASS rows).
EVAL_PER_CLASS=100

# Seed for reproducible sampling/shuffling.
RANDOM_SEED=42
